diff --git a/tests/test_backup.py b/tests/test_backup.py
new file mode 100644
index 0000000..3a9c774
--- /dev/null
+++ b/tests/test_backup.py
@@ -0,0 +1,50 @@
+import contextlib
+import io
+import json
+import os
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import tally  # noqa: E402
+
+
+class BackupTest(unittest.TestCase):
+    def setUp(self):
+        self.old_cwd = os.getcwd()
+        self.tmp = tempfile.TemporaryDirectory()
+        os.chdir(self.tmp.name)
+
+    def tearDown(self):
+        os.chdir(self.old_cwd)
+        self.tmp.cleanup()
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            code = tally.main(["tally.py", *args])
+        return code, out.getvalue()
+
+    def test_round_trip(self):
+        tally.save_ledger([{"amount": 1, "category": "food", "date": "2026-11-01"}])
+        tally.save_budgets({"food": 100})
+        tally.save_recurring([])
+        self.assertEqual(self.run_cli("backup", "--output", "b.json")[0], 0)
+        with open("b.json", encoding="utf-8") as f:
+            self.assertEqual(json.load(f)["budgets"], {"food": 100})
+        for name in ("ledger.json", "budgets.json", "recurring.json"):
+            os.remove(name)
+        self.assertEqual(self.run_cli("restore", "b.json")[0], 0)
+        self.assertEqual(tally.load_ledger()[0]["amount"], 1)
+        self.assertEqual(tally.load_budgets(), {"food": 100})
+
+    def test_restore_rejects_other_files(self):
+        with open("x.json", "w", encoding="utf-8") as f:
+            f.write("[]")
+        self.assertEqual(self.run_cli("restore", "x.json")[0], 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
