+def cmd_backup(opts, args):
+    """Write ledger, budgets and recurring rules into one JSON file: plain
+    text a person can read and diff, and safe to load (see DECISIONS.md)."""
+    if args:
+        raise UsageError(f"backup: unexpected argument: {args[0]!r}")
+    if not opts.output:
+        raise ValueError("backup requires --output FILE")
+    save_json({"ledger": load_ledger(), "budgets": load_budgets(),
+               "recurring": load_recurring()}, opts.output)
+    print(f"backed up to {opts.output}")
+
+
+def cmd_restore(opts, args):
+    if len(args) != 1:
+        raise ValueError("restore takes exactly one argument: FILE")
+    with open(args[0], encoding="utf-8") as f:
+        data = json.load(f)
+    if not (isinstance(data, dict) and isinstance(data.get("ledger"), list)
+            and isinstance(data.get("budgets"), dict)
+            and isinstance(data.get("recurring"), list)):
+        raise ValueError(f"restore: {args[0]} is not a tally backup")
+    save_ledger(data["ledger"])
+    save_budgets(data["budgets"])
+    save_recurring(data["recurring"])
+    print(f"restored {len(data['ledger'])} entries from {args[0]}")
+
+
