diff --git a/tally/money.py b/tally/money.py
index 586da54..1bf2ef8 100644
--- a/tally/money.py
+++ b/tally/money.py
@@ -23,7 +23,10 @@ def parse_amount(text):
     return int(cents)
 
 
-def format_cents(cents):
+def format_cents(cents, grouping=True):
+    """Format cents for people, like 1,234.50; grouping=False gives 1234.50
+    for files that are read back, such as CSV exports."""
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
-    return f"{sign}{cents // 100}.{cents % 100:02d}"
+    dollars = f"{cents // 100:,}" if grouping else f"{cents // 100}"
+    return f"{sign}{dollars}.{cents % 100:02d}"
