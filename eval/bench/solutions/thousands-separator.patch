+class FormatCentsTest(unittest.TestCase):
+    def test_thousands_are_grouped(self):
+        self.assertEqual(format_cents(123450), "1,234.50")
+        self.assertEqual(format_cents(123456789), "1,234,567.89")
+
+    def test_small_amounts_unchanged(self):
+        self.assertEqual(format_cents(99999), "999.99")
+
+    def test_plain_for_files(self):
+        self.assertEqual(format_cents(123450, grouping=False), "1234.50")
