@@ -1,25 +1,25 @@
 """Amount parsing and formatting. Amounts are stored as integer cents."""
 
 import os
-from decimal import Decimal, InvalidOperation
+from decimal import ROUND_HALF_UP, Decimal, InvalidOperation
 
 # Currency symbol printed before amounts; read once at import time.
 CURRENCY = os.environ.get("TALLY_CURRENCY", "$")
 
 
 def parse_amount(text):
-    """Convert a decimal amount string like '12.5' into integer cents."""
+    """Convert a decimal amount string like '12.5' into integer cents,
+    rounding to the nearest cent with halves rounded up. Decimal keeps it
+    exact: 19.99 is 1999 cents and 1.005 is 101, where float gives 100."""
     try:
         value = Decimal(text)
     except InvalidOperation:
         raise ValueError(f"invalid amount: {text!r}")
     if not value.is_finite():
         raise ValueError(f"invalid amount: {text!r}")
-    if value <= 0:
+    cents = (value * 100).to_integral_value(rounding=ROUND_HALF_UP)
+    if cents <= 0:
         raise ValueError(f"amount must be positive: {text!r}")
-    cents = value * 100
-    if cents != cents.to_integral_value():
-        raise ValueError(f"amount has more than two decimal places: {text!r}")
     return int(cents)
 
 
diff --git a/tests/test_amount.py b/tests/test_amount.py
index 91806b7..123b590 100644
--- a/tests/test_amount.py
+++ b/tests/test_amount.py
@@ -17,6 +17,15 @@ class ParseAmountTest(unittest.TestCase):
     def test_whole_number(self):
         self.assertEqual(parse_amount("5"), 500)
 
+    def test_rounds_half_up_to_the_cent(self):
+        self.assertEqual(parse_amount("19.999"), 2000)
+        self.assertEqual(parse_amount("1.005"), 101)
+        self.assertEqual(parse_amount("1.004"), 100)
+
+    def test_rounding_to_zero_is_rejected(self):
+        with self.assertRaises(ValueError):
+            parse_amount("0.004")
+
 
 if __name__ == "__main__":
     unittest.main()
