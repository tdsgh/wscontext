diff --git a/tests/test_dollar_sign.py b/tests/test_dollar_sign.py
new file mode 100644
index 0000000..5565e9a
--- /dev/null
+++ b/tests/test_dollar_sign.py
@@ -0,0 +1,23 @@
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from tally.money import parse_typed_amount  # noqa: E402
+
+
+class DollarSignTest(unittest.TestCase):
+    def test_leading_dollar_sign(self):
+        self.assertEqual(parse_typed_amount("$12.50"), 1250)
+
+    def test_plain_number(self):
+        self.assertEqual(parse_typed_amount("12.50"), 1250)
+
+    def test_sign_elsewhere_is_rejected(self):
+        with self.assertRaises(ValueError):
+            parse_typed_amount("12.50$")
+
+
+if __name__ == "__main__":
+    unittest.main()
