+++ b/tests/test_ledger_env.py
@@ -0,0 +1,37 @@
+import os
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import tally  # noqa: E402
+
+
+class LedgerEnvTest(unittest.TestCase):
+    def setUp(self):
+        self.old_cwd = os.getcwd()
+        self.tmp = tempfile.TemporaryDirectory()
+        os.chdir(self.tmp.name)
+
+    def tearDown(self):
+        os.chdir(self.old_cwd)
+        self.tmp.cleanup()
+
+    def test_ledger_follows_the_variable(self):
+        with mock.patch.dict(os.environ, {"TALLY_LEDGER": "other.json"}):
+            tally.save_ledger([{"amount": 1, "category": "food", "date": "2026-11-01"}])
+            self.assertEqual(len(tally.load_ledger()), 1)
+        self.assertTrue(os.path.exists("other.json"))
+        self.assertFalse(os.path.exists("ledger.json"))
+
+    def test_default_is_ledger_json(self):
+        with mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("TALLY_LEDGER", None)
+            tally.save_ledger([])
+        self.assertTrue(os.path.exists("ledger.json"))
+
+
+if __name__ == "__main__":
+    unittest.main()
